# =====================================================================
# Modèle de configuration.
#
# Copier en `.env`, puis renseigner. Ce fichier est le seul du dossier à
# être versionné : il ne doit donc contenir aucune valeur réelle.
#
# `php artisan key:generate` remplit APP_KEY.
# =====================================================================

APP_NAME=GOLDSHOP
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------
# En production, DB_URL suffit et prime sur les champs séparés.
# Neon impose sslmode=require ; le point d'accès « -pooler » passe par
# PgBouncer, qui exige DB_EMULATE_PREPARES=true (voir config/database.php).
DB_CONNECTION=pgsql
DB_URL=
DB_EMULATE_PREPARES=true

# Base locale sans Neon :
# DB_CONNECTION=sqlite

# ---------------------------------------------------------------------
# Sessions, files d'attente, cache
# ---------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# `file` et non `database` : sur une base distante, un cache en base coûte
# le même aller-retour que la requête qu'il est censé éviter.
CACHE_STORE=file

# ---------------------------------------------------------------------
# Frontend et authentification
# ---------------------------------------------------------------------
# Origine du site Vue : sert aux liens des e-mails, à CORS et à Sanctum.
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173

# ---------------------------------------------------------------------
# Cloudinary — envoi des visuels produits
# ---------------------------------------------------------------------
# Sans ces trois valeurs, MediaService::estConfigure() renvoie faux et tout
# envoi de média est refusé ; le reste de l'application fonctionne.
# Console : Settings > Access Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------
# Connexion Google (Socialite) — facultatif
# ---------------------------------------------------------------------
# Les routes existent, mais l'écran de connexion ne propose pas ce mode :
# laisser vide tant que le bouton n'est pas remis en place.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/auth/google/callback"

# ---------------------------------------------------------------------
# Courrier
# ---------------------------------------------------------------------
# `log` écrit les messages dans storage/logs au lieu de les envoyer.
# Pour Gmail, MAIL_PASSWORD attend un mot de passe d'application, jamais
# le mot de passe du compte.
MAIL_MAILER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contact@exemple.fr"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------------------------------------------------------------
# Réglages de boutique
# ---------------------------------------------------------------------
# Valeurs de départ seulement : l'administration les remplace en base
# (table `settings`), et une clé absente retombe ici.
BOUTIQUE_FRANCO=150
BOUTIQUE_PORT_STANDARD=6.9
BOUTIQUE_PORT_EXPRESS=12
BOUTIQUE_TVA=0.20
